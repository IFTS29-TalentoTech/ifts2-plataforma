{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2023"],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "src",
    "cypress",
    "cypress.config.ts",
    "cypress.covers.config.ts",
    "tailwind.config.ts",
    "next.config.ts",
    ".next/types/**/*.ts",
    ".next-degraded/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
