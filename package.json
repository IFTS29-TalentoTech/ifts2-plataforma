{
  "name": "ifts2-plataforma",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "pnpm -r --parallel --filter @ifts2/api --filter @ifts2/web dev",
    "build": "pnpm -r --filter @ifts2/shared --filter @ifts2/api --filter @ifts2/web build",
    "lint": "eslint . && prettier --check . && node scripts/check-no-hardcoded-styles.mjs && node scripts/generate-tokens.mjs --check",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:api": "pnpm --filter @ifts2/api test",
    "test:e2e": "pnpm --filter @ifts2/web test:e2e",
    "db:up": "docker compose up -d --wait ifts2-db",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "tokens": "node scripts/generate-tokens.mjs",
    "contrast": "node scripts/contrast.mjs",
    "lint:styles": "node scripts/check-no-hardcoded-styles.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:capturas": "node scripts/e2e.mjs --capturas",
    "e2e:full": "node scripts/e2e.mjs --build",
    "load": "node scripts/load/public-load.mjs",
    "lighthouse": "node scripts/load/lighthouse.mjs",
    "verify": "node scripts/verify-flows.mjs",
    "docs:der": "node scripts/docs/prisma-to-docs.mjs",
    "docs:pdf": "node scripts/docs/build-entrega.mjs",
    "docs:pdf:all": "node scripts/docs/build-entrega.mjs && node scripts/docs/build-entrega.mjs --no-regen --solo=Manual-Tecnico && node scripts/docs/build-entrega.mjs --no-regen --solo=Manual-de-Usuario && node scripts/docs/build-caratula.mjs",
    "docs:caratula": "node scripts/docs/build-caratula.mjs",
    "package": "node scripts/package.mjs",
    "test:covers": "node scripts/test-public-covers.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@types/node": "^24.19.2",
    "autocannon": "^8.0.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "zod": "^3.25.76"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
