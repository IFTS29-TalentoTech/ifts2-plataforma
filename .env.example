# Copiá este archivo a .env y ajustá los valores. Nunca versiones .env.
NODE_ENV=development

# ---- Base de datos (contenedor ifts2-db, puerto 5433). Pruebas: ifts2_test ----
DATABASE_URL=postgresql://ifts2:ifts2@localhost:5433/ifts2
TEST_DATABASE_URL=postgresql://ifts2:ifts2@localhost:5433/ifts2_test

# ---- Orígenes (CORS, cookies, redirección de OAuth) ----
# Si el puerto 3000 está ocupado: PORT=3100 pnpm --filter @ifts2/web dev  y APP_ORIGIN=http://localhost:3100
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
API_PORT=4000
# Detrás de un proxy/hosting (cantidad de proxies de confianza)
TRUST_PROXY=0

# ---- Sesión ----
SESSION_COOKIE_NAME=ifts2_session
SESSION_TTL_HOURS=8
SESSION_REMEMBER_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---- Cifrado de secretos guardados en la base (Instagram, SMTP) ----
# Clave de 32 bytes en base64. Generá una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# La de abajo es SOLO para desarrollo.
APP_ENCRYPTION_KEY=ZGV2LW9ubHktZXhhbXBsZS1rZXktMzItYnl0ZXMhISE=

# ---- Almacenamiento (infraestructura: lo configura DevOps) ----
# local = disco (uploads/) | memory = pruebas | s3 = compatible S3 (Supabase Storage, Cloudflare R2, MinIO, AWS)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_SIGNING_SECRET=dev-only-storage-signing-secret-change-me
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Solo si STORAGE_PROVIDER=s3 (si falta alguna obligatoria, la API no arranca):
# S3_ENDPOINT=https://<proyecto>.supabase.co/storage/v1/s3
# S3_BUCKET=ifts2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PUBLIC_URL=https://cdn.ejemplo.com        # opcional: CDN para imágenes públicas
# S3_FORCE_PATH_STYLE=true

# ---- Correo: VALORES POR DEFECTO. El cliente lo configura desde el panel (Configuración) ----
# console = no envía, solo registra (modo demostración) | smtp = envía con nodemailer
MAILER_PROVIDER=console
# SMTP_URL=smtp://usuario:clave@smtp.ejemplo.com:587
CONTACT_TO_EMAIL=

# ---- Instagram: VALORES POR DEFECTO. El cliente los carga desde el panel (su app de Meta) ----
# fake = demostración | graph = API real (exige App ID y Secret)
INSTAGRAM_PROVIDER=fake
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# Por defecto: ${API_ORIGIN}/api/v1/integrations/instagram/callback
# INSTAGRAM_REDIRECT_URI=

# ---- Sitio ----
REVALIDATE_SECRET=dev-only-revalidate-secret
LOG_LEVEL=info

# ---- Semilla: prod | demo ----
# demo: usuarios de demostración (clave Demo-2026-ifts2) y datos de ejemplo. prod: solo administrador, ajustes y enlaces.
SEED_MODE=demo
SEED_ADMIN_EMAIL=admin@ifts2.local
SEED_ADMIN_PASSWORD=Cambiame-123!
