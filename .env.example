# Copiá este archivo a .env y ajustá los valores. Nunca versiones .env.
NODE_ENV=development

# Base de datos (contenedor ifts2-db, puerto 5433). Pruebas: .../ifts2_test
DATABASE_URL=postgresql://ifts2:ifts2@localhost:5433/ifts2
TEST_DATABASE_URL=postgresql://ifts2:ifts2@localhost:5433/ifts2_test

# Orígenes (CORS, cookies, revalidación)
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Sesión
SESSION_COOKIE_NAME=ifts2_session
SESSION_TTL_HOURS=8

# Clave de 32 bytes en base64 para cifrar el token de Instagram.
# Generá una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=ZGV2LW9ubHktZXhhbXBsZS1rZXktMzItYnl0ZXMhISE=

# Instagram (Graph API). Vacío = se usa el cliente falso.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# Almacenamiento: local | supabase | cloudinary (solo local está implementado)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_SIGNING_SECRET=dev-only-storage-signing-secret-change-me
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# CLOUDINARY_URL=

# Correo: vacío o "console" = escribe en consola. Ej: smtp://usuario:clave@host:587
SMTP_URL=
CONTACT_TO_EMAIL=dfts_ifts2_de20@bue.edu.ar

# Revalidación bajo demanda del sitio público
REVALIDATE_SECRET=dev-only-revalidate-secret

# Semilla: prod | demo
SEED_MODE=demo
SEED_ADMIN_EMAIL=admin@ifts2.local
SEED_ADMIN_PASSWORD=Cambiame-123!
